<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.Styling"
             x:Class="MouseClicker.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <fa:FluentAvaloniaTheme />
    </Application.Styles>

    <Application.Resources>
        <!-- 统一应用强调色：让 Fluent 控件（Slider/ToggleSwitch/ComboBox/Button）与自绘元素使用同一主色 -->
        <Color x:Key="SystemAccentColor">#4F6EF7</Color>
        <Color x:Key="SystemAccentColorLight1">#4F6EF7</Color>
        <Color x:Key="SystemAccentColorLight2">#4F6EF7</Color>
        <Color x:Key="SystemAccentColorLight3">#4F6EF7</Color>
        <Color x:Key="SystemAccentColorDark1">#4F6EF7</Color>
        <Color x:Key="SystemAccentColorDark2">#4F6EF7</Color>
        <Color x:Key="SystemAccentColorDark3">#4F6EF7</Color>

        <SolidColorBrush x:Key="AccentBrush" Color="#4F6EF7" />
        <SolidColorBrush x:Key="WindowBgBrush" Color="#F4F5FA" />
        <SolidColorBrush x:Key="TextBrush" Color="#2B2F38" />
        <SolidColorBrush x:Key="SubTextBrush" Color="#8A90A0" />
    </Application.Resources>
</Application>
