<Window x:Class="MouseClicker.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        Title="连点器设置"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <!-- 图标按钮：透明背景，悬停显示浅灰 -->
        <ControlTheme x:Key="IconButtonTheme" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Bg">
                <Setter Property="Background" Value="#E8EAF2" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <!-- 开关按钮：不显示 On/Off 文本 -->
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
        </Style>

        <!-- 数值输入框 -->
        <Style Selector="TextBox.valuebox">
            <Setter Property="Width" Value="72" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,3" />
        </Style>

        <!-- 设置项内滑块宽度统一、自由滑动 -->
        <Style Selector="Slider.settingslider">
            <Setter Property="Width" Value="160" />
        </Style>

        <!-- 设置项右侧控件宽度统一 -->
        <Style Selector="ComboBox.settingscombo">
            <Setter Property="Width" Value="150" />
        </Style>
    </Window.Styles>

    <Border CornerRadius="14"
            Margin="24"
            BorderBrush="#D9DCE5"
            BorderThickness="1"
            BoxShadow="0 2 16 0 #47000000">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FFFFFF" />
                <GradientStop Offset="1" Color="#ECEEF6" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="16,10,16,16" KeyDown="Root_KeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" PointerPressed="TitleBar_PointerPressed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="连点器设置" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource IconButtonTheme}"
                        ToolTip.Tip="关闭"
                        Click="CloseButton_Click">
                    <fa:SymbolIcon Symbol="Cancel" FontSize="12" />
                </Button>
            </Grid>

            <!-- 设置内容：Win11 设置风格分组 -->
            <ScrollViewer Grid.Row="1" Margin="0,14,0,0" MaxHeight="460"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">

                    <!-- 组 1：点击 -->
                    <fa:SettingsExpander Header="点击" Description="连点间隔、随机延迟与点击方式">
                        <fa:SettingsExpanderItem Description="1~1000 毫秒">
                            <fa:SettingsExpanderItem.IconSource>
                                <fa:SymbolIconSource Symbol="Clock" />
                            </fa:SettingsExpanderItem.IconSource>
                            <fa:SettingsExpanderItem.Content>
                                <TextBlock Text="点击间隔" />
                            </fa:SettingsExpanderItem.Content>
                            <fa:SettingsExpanderItem.Footer>
                                <StackPanel>
                                    <Slider Classes="settingslider" Minimum="1" Maximum="1000"
                                            SmallChange="5" LargeChange="50"
                                            Value="{Binding Settings.Interval}" />
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock Text="毫秒" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource SubTextBrush}" Margin="6,0,0,0" />
                                        <TextBox Classes="valuebox"
                                                 Text="{Binding Settings.Interval, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </StackPanel>
                            </fa:SettingsExpanderItem.Footer>
                        </fa:SettingsExpanderItem>

                        <fa:SettingsExpanderItem Description="每次点击叠加 0~上限 毫秒">
                            <fa:SettingsExpanderItem.IconSource>
                                <fa:SymbolIconSource Symbol="Refresh" />
                            </fa:SettingsExpanderItem.IconSource>
                            <fa:SettingsExpanderItem.Content>
                                <TextBlock Text="随机延迟" />
                            </fa:SettingsExpanderItem.Content>
                            <fa:SettingsExpanderItem.Footer>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="启用随机延迟" VerticalAlignment="Center" />
                                        <ToggleSwitch IsChecked="{Binding Settings.UseRandomDelay}"
                                                      VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Slider Classes="settingslider" Margin="0,4,0,0" Minimum="1" Maximum="1000"
                                            SmallChange="5" LargeChange="50"
                                            IsEnabled="{Binding Settings.UseRandomDelay}"
                                            Value="{Binding Settings.RandomDelayMax}" />
                                    <DockPanel Margin="0,4,0,0" IsEnabled="{Binding Settings.UseRandomDelay}">
                                        <TextBlock Text="毫秒内" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource SubTextBrush}" Margin="6,0,0,0" />
                                        <TextBox Classes="valuebox"
                                                 Text="{Binding Settings.RandomDelayMax, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </StackPanel>
                            </fa:SettingsExpanderItem.Footer>
                        </fa:SettingsExpanderItem>

                        <fa:SettingsExpanderItem Description="左键 / 右键 / 中键">
                            <fa:SettingsExpanderItem.IconSource>
                                <fa:SymbolIconSource Symbol="TouchPointer" />
                            </fa:SettingsExpanderItem.IconSource>
                            <fa:SettingsExpanderItem.Content>
                                <TextBlock Text="点击模式" />
                            </fa:SettingsExpanderItem.Content>
                            <fa:SettingsExpanderItem.Footer>
                                <ComboBox Classes="settingscombo"
                                          ItemsSource="{Binding Settings.ClickTypes}"
                                          SelectedItem="{Binding Settings.SelectedClickType}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </fa:SettingsExpanderItem.Footer>
                        </fa:SettingsExpanderItem>

                        <fa:SettingsExpanderItem Description="单击 / 双击 / 按下并释放">
                            <fa:SettingsExpanderItem.IconSource>
                                <fa:SymbolIconSource Symbol="Switch" />
                            </fa:SettingsExpanderItem.IconSource>
                            <fa:SettingsExpanderItem.Content>
                                <TextBlock Text="点击方式" />
                            </fa:SettingsExpanderItem.Content>
                            <fa:SettingsExpanderItem.Footer>
                                <ComboBox Classes="settingscombo"
                                          ItemsSource="{Binding Settings.ClickModes}"
                                          SelectedItem="{Binding Settings.SelectedClickMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </fa:SettingsExpanderItem.Footer>
                        </fa:SettingsExpanderItem>
                    </fa:SettingsExpander>

                    <!-- 组 2：坐标与窗口 -->
                    <fa:SettingsExpander Header="坐标与窗口" Description="坐标锁定、置顶与拖动锁定">
                        <fa:SettingsExpanderItem Description="每次点击前移动到目标坐标">
                            <fa:SettingsExpanderItem.IconSource>
                                <fa:SymbolIconSource Symbol="Target" />
                            </fa:SettingsExpanderItem.IconSource>
                            <fa:SettingsExpanderItem.Content>
                                <TextBlock Text="坐标锁定" />
                            </fa:SettingsExpanderItem.Content>
                            <fa:SettingsExpanderItem.Footer>
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="启用坐标锁定" VerticalAlignment="Center" />
                                        <ToggleSwitch IsChecked="{Binding Settings.LockPosition}"
                                                      VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding Settings.LockPosition}">
                                        <TextBlock Text="目标：" VerticalAlignment="Center"
                                                   Foreground="{StaticResource SubTextBrush}" />
                                        <TextBlock Text="{Binding Settings.TargetText}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <Button Content="取当前坐标" Command="{Binding PickPositionCommand}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding Settings.LockPosition}">
                                        <TextBlock Text="实时位置：" VerticalAlignment="Center"
                                                   Foreground="{StaticResource SubTextBrush}" />
                                        <TextBlock x:Name="LivePositionText" Text="—" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="移动鼠标到目标位置后按 Ctrl+S 确定" FontSize="11"
                                               Foreground="{StaticResource SubTextBrush}"
                                               IsEnabled="{Binding Settings.LockPosition}" />
                                </StackPanel>
                            </fa:SettingsExpanderItem.Footer>
                        </fa:SettingsExpanderItem>

                        <fa:SettingsExpanderItem Description="主窗口始终位于其他窗口之上">
                            <fa:SettingsExpanderItem.IconSource>
                                <fa:SymbolIconSource Symbol="Pin" />
                            </fa:SettingsExpanderItem.IconSource>
                            <fa:SettingsExpanderItem.Content>
                                <TextBlock Text="窗口置顶" />
                            </fa:SettingsExpanderItem.Content>
                            <fa:SettingsExpanderItem.Footer>
                                <ToggleSwitch IsChecked="{Binding Settings.IsTopmost}" />
                            </fa:SettingsExpanderItem.Footer>
                        </fa:SettingsExpanderItem>

                        <fa:SettingsExpanderItem Description="锁定后主窗口不可拖动">
                            <fa:SettingsExpanderItem.IconSource>
                                <fa:SymbolIconSource Symbol="ProtectedDocument" />
                            </fa:SettingsExpanderItem.IconSource>
                            <fa:SettingsExpanderItem.Content>
                                <TextBlock Text="锁定窗口" />
                            </fa:SettingsExpanderItem.Content>
                            <fa:SettingsExpanderItem.Footer>
                                <ToggleSwitch IsChecked="{Binding Settings.LockWindow}" />
                            </fa:SettingsExpanderItem.Footer>
                        </fa:SettingsExpanderItem>
                    </fa:SettingsExpander>

                    <!-- 组 3：热键 -->
                    <fa:SettingsExpander Header="热键" Description="后台启动/停止连点">
                        <fa:SettingsExpanderItem Description="点击按钮后按下新按键录制">
                            <fa:SettingsExpanderItem.IconSource>
                                <fa:SymbolIconSource Symbol="Keyboard" />
                            </fa:SettingsExpanderItem.IconSource>
                            <fa:SettingsExpanderItem.Content>
                                <TextBlock Text="启动热键" />
                            </fa:SettingsExpanderItem.Content>
                            <fa:SettingsExpanderItem.Footer>
                                <Button Content="{Binding Settings.HotKeyButtonText}"
                                        MinWidth="150" HorizontalAlignment="Right"
                                        Click="HotKeyButton_Click" />
                            </fa:SettingsExpanderItem.Footer>
                        </fa:SettingsExpanderItem>
                    </fa:SettingsExpander>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="关于" Click="AboutButton_Click" Margin="0,0,8,0" />
                <Button Content="恢复默认" Click="ResetButton_Click" Margin="0,0,8,0" />
                <Button Content="完成" Click="DoneButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
